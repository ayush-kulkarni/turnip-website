---
import { Image } from "astro:assets";
import srcImage1 from "../assets/turnip_1.png";
import srcImage2 from "../assets/turnip_2.png";
---

<div
  class="flex lg:flex-row flex-col lg:items-start items-center gap-20 lg:gap-50 min-h-[calc(100dvh-80px)] mt-10"
>
  <div class="flex flex-col lg:gap-8 max-lg:gap-5 min-w-0">
    <h1
      class="font-medium text-8xl lg:pl-20 max-lg:text-center text-left"
      style="color: var(--color-primary-dark)"
    >
      Meet Turnip
    </h1>
    <h2
      class="font-light text-4xl lg:pl-20 max-lg:text-3xl max-lg:text-center text-left"
      style="color: var(--color-primary)"
    >
      Find your next meal with just a picture
    </h2>
    <p
      class="font-light text-xl lg:pl-20 text-gray-600 max-lg:text-center lg:-mt-4 text-left max-w-prose max-lg:pl-10 max-lg:pr-10"
    >
      Meet Turnip, the AI-powered app that turns your pantry into your next
      meal. Snap one or more photos of your fridge or pantry and Turnip
      automatically identifies what's there, then hands you recipes you can cook
      right now. No manual entry, no wasted ingredients.
    </p>
    <div
      class="lg:pl-20 max-lg:flex max-lg:justify-center cursor-pointer select-none"
    >
      <a
        href="https://apps.apple.com/us/app/turnip-cooking-made-simple/id6798474011?itscg=30200&itsct=apps_box_badge&mttnsubad=6798474011"
        class="flex items-center"
        draggable="false"
      >
        <img
          src="https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-app-store/black/en-us?releaseDate=1787788800"
          alt="Download on the App Store"
          class="w-40 h-15 block"
          draggable="false"
        />
      </a>
    </div>
  </div>

  <div class="shrink-0 lg:pr-20 -translate-y-10">
    <div class="relative w-[clamp(336px,50vw,720px)] aspect-4/3 select-none">
      <div class="absolute left-0 top-[10%] w-[50%]">
        <Image
          src={srcImage1}
          alt="Turnip Preview 1"
          class="w-full h-auto -rotate-5"
          draggable="false"
        />
      </div>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="3"
        stroke="var(--color-primary)"
        class="absolute left-[47%] top-[42%] w-[7%] h-auto"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
      </svg>

      <div class="absolute left-[54%] top-[10%] w-[46%]">
        <Image
          src={srcImage2}
          alt="Turnip Preview 2"
          class="w-full h-auto rotate-5"
          draggable="false"
        />
      </div>
    </div>
  </div>
</div>
