---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
export interface Props {
  imgSrc: ImageMetadata;
}
const { imgSrc } = Astro.props;
---

<div>
  <Image
    class="w-full rounded-2xl"
    src={imgSrc}
    alt="Turnip Iphone Preview"
    draggable="false"
  />
</div>
