{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "tryturnip-app",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
}
